# Port and bind address for HTTPS Web IP Caller
BIND_HOST=0.0.0.0
HTTPS_PORT=5443

# PIN required to unlock the Web Dialer UI (change anytime via: ./ip_caller.py set-pin <PIN>)
CALLER_PIN=2580

# Random HMAC secret for 30-day session cookies (auto-generated if blank)
SESSION_SECRET=

# Target Android USB ADB device serial
ADB_SERIAL=<ADB_SERIAL>

# ALSA Analog device for 3.5mm Rear Blue (Line In) & Rear Green (Line Out)
ALSA_DEVICE=plughw:0,0

# Default ALC897 mixer levels during calls (Capture 0-63, Front Out 0-87)
CAPTURE_VOLUME=54
LINE_OUT_VOLUME=45
HUM_FILTER_ENABLED=true
