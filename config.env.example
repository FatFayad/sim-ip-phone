# Discord channel webhook URL (required for live Discord delivery)
DISCORD_WEBHOOK_URL=

# Optional Discord mention prepended to alerts (e.g. @everyone, @here, or <@123456789012345678>)
DISCORD_MENTION=

# Specific USB ADB device serial (leave blank to auto-use any single connected USB device)
ADB_SERIAL=<ADB_SERIAL>

# Poll interval in seconds (events logcat watcher also wakes checks immediately)
POLL_INTERVAL_SECONDS=2.5

# Send alert if USB ADB disconnects for >120s (true/false)
ALERT_ON_DISCONNECT=true

# Comma-separated extra Android package names to forward notifications from (optional)
EXTRA_WATCH_PACKAGES=
